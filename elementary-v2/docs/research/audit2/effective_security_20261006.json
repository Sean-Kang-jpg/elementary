{
  "views": [
    {
      "name": "index_usage_stats",
      "options": null,
      "definition": " SELECT schemaname,\n    relname AS tablename,\n    indexrelname AS indexname,\n    idx_tup_read,\n    idx_tup_fetch,\n    idx_scan,\n        CASE\n            WHEN idx_scan = 0 THEN 'Never used'::text\n            WHEN idx_scan < 100 THEN 'Rarely used'::text\n            WHEN idx_scan < 1000 THEN 'Moderately used'::text\n            ELSE 'Heavily used'::text\n        END AS usage_level\n   FROM pg_stat_user_indexes\n  WHERE schemaname = 'public'::name AND (relname = ANY (ARRAY['schools'::name, 'apartments'::name, 'apartment_school_mappings'::name]))\n  ORDER BY idx_scan DESC;"
    }
  ],
