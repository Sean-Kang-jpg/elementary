# 🔑 Elementary School v2.0 Environment Variables Template
# ===================================================
# 이 파일을 .env로 복사하고 실제 API 키로 변경하세요

# 네이버 지도 API 설정
NAVER_MAPS_CLIENT_ID=your_naver_maps_client_id

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-side ETL only. Never expose this as a VITE_ variable.
SUPABASE_SERVICE_KEY=your_supabase_service_key
# Optional Slack-compatible webhook for scheduled ETL failures.
ETL_ALERT_WEBHOOK_URL=

# ===================================================
# 📊 정부 API 키 (데이터 소스)
# ===================================================

# NEIS Open API Keys (교육청 오픈 API)
# 발급: https://open.neis.go.kr/portal/guide/actKeyPage.do
NEIS_SCHOOL_API_KEY=your_neis_school_api_key
NEIS_CLASS_API_KEY=your_neis_class_api_key

# 국토교통부 API Key (아파트, 초등학교 위치 데이터)
# 발급: https://www.data.go.kr/data/15057332/openapi.do
MOLIT_API_KEY=your_molit_api_key
MOLIT_API_KEY_ENCODED=your_molit_api_key_encoded
DATA_GO_KR_DECODED_KEY=your_decoded_data_go_kr_key

# VWorld Geocoding API Key (국토교통부 지오코딩)  
# 발급: https://www.vworld.kr/dev/v4dv_2dtlguide2_s002.do
VWORLD_API_KEY=your_vworld_api_key

# KERIS 학교정보 API Key (학년별 학생수, 학급수 데이터)
# 발급: https://schoolinfo.go.kr/ng/go/pnnggo_a01_l0.do
KERIS_SCHOOLINFO_API_KEY=your_keris_api_key

# ===================================================
# 🚀 배포 및 CI/CD 설정
# ===================================================

# Vercel 배포 설정 (필수)
# 발급: https://vercel.com/account/tokens
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id  
VERCEL_TOKEN=your_vercel_token

# GitHub Actions 배포용 (선택사항)
# 발급: GitHub Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=your_github_token
