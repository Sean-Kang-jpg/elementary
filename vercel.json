{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd elementary-v2 && npm ci",
  "buildCommand": "cd elementary-v2 && npm run build",
  "outputDirectory": "elementary-v2/dist",
  "functions": {
    "api/detail.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/school/(.*)",
      "destination": "/api/detail?type=school&slug=$1"
    },
    {
      "source": "/apt/(.*)",
      "destination": "/api/detail?type=apt&slug=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
