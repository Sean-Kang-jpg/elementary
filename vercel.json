{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd elementary-v2 && npm ci",
  "buildCommand": "cd elementary-v2 && npm run build",
  "outputDirectory": "elementary-v2/dist",
  "functions": {
    "api/detail.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
